# Optional for this app's Auth and Firestore features.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_WHATSAPP_NUMBER=
VITE_WHATSAPP_COMMUNITY_URL=